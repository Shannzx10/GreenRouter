# Contoh konfigurasi lingkungan GreenRouter. Salin ke .env dan isi
# nilainya. Berkas .env sungguhan TIDAK ikut Git dan nilainya rahasia:
# jangan pernah membagikan isinya.

# Basis data dan aplikasi
DATABASE_URL=
APP_URL=
APP_SECRET=
ENCRYPTION_KEY=

# Akun admin awal (dipakai seed saat tabel user masih kosong)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Login OAuth (Google dan GitHub)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Paddle (pembayaran). API key dan secret webhook bersifat rahasia;
# client token memang untuk sisi klien. NEXT_PUBLIC_PADDLE_ENV berisi
# "sandbox" atau "production" mengikuti lingkungannya.
PADDLE_API_KEY=
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_MAX_MONTHLY=
PADDLE_PRICE_MAX_YEARLY=
# Warisan lama, masih dibaca sebagai cadangan: PADDLE_PRICE_PRO,
# PADDLE_PRICE_MAX
