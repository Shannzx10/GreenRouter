// GreenRouter — skema database gateway AI
// Provider & pool key hulu, katalog model + routing per model,
// key klien (tersimpan sebagai hash), dan log pemakaian.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  role              String   @default("ADMIN")
  name              String?
  image             String?
  authProviders     String   @default("password")
  isActive          Boolean  @default(true)
  // Kuota token per siklus 7 hari (jangkar: tanggal akun dibuat).
  // Nama kolom DB dipertahankan dari era limit bulanan lewat @map.
  tokenLimit        Int?     @map("tokenLimitMonthly")
  // Batas request per jam (jendela bergeser 60 menit, dihitung per akun).
  // NULL = tanpa batas, sama seperti tokenLimit.
  requestLimitHourly Int?
  // Suspend oleh admin: sejak kapan + alasan opsional. Selama terisi, akun
  // terkunci ke halaman /suspended; lewat 3 hari tanpa dibatalkan, akun
  // dihapus permanen dan emailnya masuk Blacklist (lihat lib/suspension).
  suspendedAt       DateTime?
  suspendReason     String?
  // Plan langganan (gratis | pro | max, lihat lib/plans) dan cerminan
  // keadaan langganan Paddle. Kolom-kolom ini HANYA ditulis oleh handler
  // webhook Paddle (server/paddle-events) dan menjadi dasar limit akun:
  // saat plan berubah, tokenLimit + requestLimitHourly disetel dari
  // definisi plan. paddleLastEventAt menjaga urutan event (event lama
  // yang tiba belakangan tidak boleh menimpa keadaan yang lebih baru).
  plan               String    @default("gratis")
  paddleCustomerId   String?
  paddleSubscriptionId String?
  paddleSubStatus    String?
  paddleLastEventAt  DateTime?
  apiKeys           ApiKey[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Email yang dilarang mendaftar lagi: hasil purge akun tersuspend yang
// kedaluwarsa. Dicek pada jalur pembuatan akun OAuth.
model Blacklist {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

model ApiKey {
  id         String     @id @default(cuid())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  prefix     String
  keyHash    String     @unique
  isActive   Boolean    @default(true)
  lastUsedAt DateTime?
  usageLogs  UsageLog[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([keyHash])
}

model Provider {
  id           String        @id @default(cuid())
  name         String        @unique
  baseUrl      String
  isActive     Boolean       @default(true)
  // URL endpoint sisa kuota per key (mis. Dahl /tokens/current). Bila terisi,
  // gateway mengecek sisa token key SEBELUM setiap request diteruskan;
  // sisa 0 berarti key ditandai LIMITED dan dikeluarkan dari rotasi.
  quotaCheckUrl String?
  // Profil kapasitas untuk halaman diagnosis (diisi manual oleh admin):
  // jenis jatah (mis. "Allowance gratis", "Stok token", "Jatah USD harian"),
  // besaran, pola reset, catatan rate limit, dan catatan bebas.
  quotaKind     String?
  quotaAmount   String?
  quotaReset    String?
  rateLimitNote String?
  notes         String?
  // false bila hulu tidak melayani endpoint Anthropic /messages secara
  // native (mis. Dahl); jalur Anthropic untuk provider ini diterjemahkan
  // GreenRouter lewat endpoint OpenAI-nya (lihat anthropic-translate.ts).
  supportsAnthropic Boolean @default(true)
  upstreamKeys UpstreamKey[]
  routes       ModelRoute[]
  usageLogs    UsageLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model UpstreamKey {
  id            String     @id @default(cuid())
  providerId    String
  provider      Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  label         String
  encryptedKey  String
  keyHint       String
  status        String     @default("ACTIVE") // ACTIVE | COOLDOWN | DISABLED | LIMITED (402, menunggu tindakan admin)
  cooldownUntil DateTime?
  failCount     Int        @default(0)
  usageLogs     UsageLog[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([providerId, status])
}

model ModelCatalog {
  id              String       @id @default(cuid())
  modelId         String       @unique
  displayName     String
  // Metadata tampilan katalog (disinkron dari provider hulu, bisa diedit admin).
  contextTokens   Int?
  maxOutputTokens Int?
  inputModalities String? // daftar dipisah koma: text,image,video,pdf,audio
  capabilities    String? // daftar dipisah koma: reasoning,tool_call,structured_output,attachment
  knowledgeCutoff String? // format "YYYY-MM"
  routes          ModelRoute[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model ModelRoute {
  id              String       @id @default(cuid())
  modelId         String
  model           ModelCatalog @relation(fields: [modelId], references: [id], onDelete: Cascade)
  providerId      String
  provider        Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  upstreamModelId String
  priority        Int          @default(0)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([modelId, providerId])
  @@index([modelId, isActive])
}

// Pengumuman dari admin yang tampil di dashboard semua user.
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Hasil tes kesehatan otomatis: satu chat sederhana ke tiap model katalog
// sekali per 24 jam (dipicu watchdog). Sengaja BUKAN UsageLog: tes ini
// bukan pemakaian user, tidak boleh mengotori statistik maupun kuota.
model ModelHealthCheck {
  id        String   @id @default(cuid())
  modelId   String
  status    String // "SUCCESS" | "ERROR"
  latencyMs Int
  error     String?
  checkedAt DateTime @default(now())

  @@index([modelId, checkedAt])
}

model UsageLog {
  id               String       @id @default(cuid())
  // Pemilik key saat request terjadi — ditulis permanen (denormal) agar
  // hitungan kuota TIDAK reset saat user menghapus key-nya: relasi apiKey
  // di bawah SetNull, kolom ini tidak ikut berubah. Tanpa relasi FK supaya
  // riwayat tetap utuh walau user/key dihapus.
  userId           String?
  apiKeyId         String?
  apiKey           ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  providerId       String?
  provider         Provider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  upstreamKeyId    String?
  upstreamKey      UpstreamKey? @relation(fields: [upstreamKeyId], references: [id], onDelete: SetNull)
  modelId          String
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  latencyMs        Int?
  status           String // SUCCESS | ERROR
  error            String?
  createdAt        DateTime     @default(now())

  @@index([createdAt])
  @@index([apiKeyId, createdAt])
  @@index([userId, createdAt])
}
